# Copy this file to .env and adjust values for your machine. Never commit
# the real .env file — it is git-ignored.

# Human-readable app name, shown in API docs.
PROJECT_NAME=Grocery ERP/POS

# development | staging | production
# In production, interactive API docs (/docs, /redoc) are disabled.
ENVIRONMENT=development

# PostgreSQL connection string (SQLAlchemy + psycopg3 driver).
# When running under `docker compose up`, this is overridden to point at
# the `db` service — see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://erp_user:erp_password@localhost:5432/erp_dev

# Reserved for future JWT signing (see docs/TECHNICAL_BLUEPRINT.md Section
# H). MUST be replaced with a long, random value before any deployment
# beyond local development — never reuse this default.
SECRET_KEY=dev-only-insecure-secret-key-change-me

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
