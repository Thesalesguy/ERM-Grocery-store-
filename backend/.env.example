# Copy this file to .env and adjust values for your machine. Never commit
# the real .env file — it is git-ignored.

# Human-readable app name, shown in API docs.
PROJECT_NAME=Grocery ERP/POS

# development | staging | production
# In production, interactive API docs (/docs, /redoc) are disabled.
ENVIRONMENT=development

# PostgreSQL connection string the RUNNING APPLICATION uses (SQLAlchemy +
# psycopg3 driver). This must be the restricted "erp_app" role, not the
# schema-owning role — see docs/M1_DATABASE_DESIGN.md "Audit-log & ledger
# write protection" and backend/scripts/bootstrap_db_roles.sql (run that
# script once, as a superuser, before first use in a new environment).
# When running under `docker compose up`, this is overridden to point at
# the `db` service — see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://erp_app:erp_app_password@localhost:5432/erp_dev

# Connection string ALEMBIC uses to run migrations. Must be the
# schema-owning role (full DDL rights) — NOT the same role as
# DATABASE_URL above. Falls back to DATABASE_URL if unset, but that only
# works if that role also owns the schema (fine for a quick throwaway
# setup, wrong for anything else).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://erp_user:erp_password@localhost:5432/erp_dev

# Reserved for future JWT signing (see docs/TECHNICAL_BLUEPRINT.md Section
# H). MUST be replaced with a long, random value before any deployment
# beyond local development — never reuse this default.
SECRET_KEY=dev-only-insecure-secret-key-change-me

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
