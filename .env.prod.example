# M13: template for the production secrets file. Copy to `.env.prod`
# (already git-ignored via `.env.*`, matching backend/.env.example's own
# convention) and fill in real values — never commit the real file, never
# put real values in this template.
#
# Loaded by: docker compose -f docker-compose.yml -f docker-compose.prod.yml
#            --env-file .env.prod ...
# (docs/M13_DESIGN.md Section 9 / Section 10's deploy.sh)

# --- Database ---------------------------------------------------------
POSTGRES_USER=erp_user
# The schema-owning role's password (migrations only — never the
# runtime application role). Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
POSTGRES_DB=erp_prod
# The restricted runtime role's password (app.core.config.DATABASE_URL
# — see docs/M1_DATABASE_DESIGN.md). MUST differ from POSTGRES_PASSWORD.
ERP_APP_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_VALUE

# --- Application --------------------------------------------------------
# JWT signing key. M12's fail-closed validator (app/core/config.py)
# refuses to boot in production with a short or known-insecure value —
# generate with: openssl rand -base64 48
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS

# The real public origin(s) the frontend is served from — never a
# wildcard (M12's validator refuses "*" in production).
PRODUCTION_CORS_ORIGINS=https://erp.example.com

# --- Backup (M13 Phase 5) ----------------------------------------------
# An `age` public key to encrypt backups with (generate the matching
# private key OFFLINE, on a machine that isn't this server, with
# `age-keygen` — see docs/M13_HARDENING_AUDIT.md Section 5 for why the
# private key must never live on the same host as the backups it
# decrypts).
BACKUP_AGE_PUBLIC_KEY=age1CHANGE_ME

# rclone remote name (configured separately via `rclone config` — never
# put rclone's own stored credentials in this file; see
# deploy/scripts/backup_offbox.sh).
BACKUP_RCLONE_REMOTE=off-box-backup
